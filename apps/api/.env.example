# Environment
NODE_ENV=development
PORT=3001

# AWS (local)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DYNAMODB_ENDPOINT=http://localhost:4566

# Redis
REDIS_URL=redis://localhost:6379

# DynamoDB table names — Editorial context (source of truth)
EDITORIAL_ARTICLES_TABLE=dev-editorial-articles
EDITORIAL_BLOGS_TABLE=dev-editorial-blogs
EDITORIAL_UPDATES_TABLE=dev-editorial-updates

# DynamoDB table names — Delivery context (materialized read models)
DELIVERY_ARTICLES_TABLE=dev-delivery-articles
DELIVERY_BLOGS_TABLE=dev-delivery-blogs
DELIVERY_UPDATES_TABLE=dev-delivery-updates
DELIVERY_CHAT_MESSAGES_TABLE=dev-delivery-chat-messages

# Event publishing
EVENT_PUBLISHER=inprocess
# EVENTBRIDGE_BUS_NAME=bbtg-news-events

# CORS
ALLOWED_ORIGIN=http://localhost:3000
