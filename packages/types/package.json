{
  "name": "@bbtg-news/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "./models": {
      "types": "./src/models.ts",
      "default": "./dist/models.js"
    },
    "./events": {
      "types": "./src/events.ts",
      "default": "./dist/events.js"
    },
    "./api": {
      "types": "./src/api.ts",
      "default": "./dist/api.js"
    }
  },
  "typesVersions": {
    "*": {
      "constants": ["src/constants.ts"],
      "models": ["src/models.ts"],
      "events": ["src/events.ts"],
      "api": ["src/api.ts"]
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
